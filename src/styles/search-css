/* SearchInput.css */

.kit-search-wrapper {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
  }
  
  .kit-search-input-container {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    background-color: #ffffff;
  }
  
  .kit-search-icon {
    position: absolute;
    left: 12px;
  }
  
  .kit-search-input {
    width: 100%;
    height: 46px;
    border: none;
    outline: none;
    padding: 0 12px 0 46px;
    font-size: 15px;
    color: #333;
    border-radius: 8px;
  }
  
  .kit-search-input::placeholder {
    color: #b6bbc1;
  }
  
  .kit-search-input:disabled {
    background-color: #f5f5f5;
    cursor: not-allowed;
  }
  
  .kit-search-button {
    height: 46px;
    padding: 0 20px;
    border: none;
    border-radius: 8px;
    background-color: #0062cc;
    color: white;
    font-weight: 500;
    font-size: 15px;
    cursor: pointer;
    white-space: nowrap;
  }
  
  .kit-search-button:hover:not(:disabled) {
    background-color: #0056b3;
  }
  
  .kit-search-button:disabled {
    background-color: #6c757d;
    cursor: not-allowed;
    opacity: 0.7;
  }
  
  /* Responsive adjustments */
  @media (max-width: 576px) {
    .kit-search-wrapper {
      flex-direction: column;
      gap: 8px;
    }
    
    .kit-search-button {
      width: 100%;
    }
  }